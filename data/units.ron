// Unit types. Moves are movement points per turn (entering flat open land costs 1),
// sight is how many tiles away the unit can see, strength its combat power in
// melee and defence; `ranged`/`range` let a unit shoot from a distance.
// `art` names the model the client builds for it; `tech` the technology that
// unlocks it (none: available from the start).
// `bonuses` are conditional combat bonuses in percent. Units with `replaces`
// are unique to one civilization (see civs.ron) and take the place of that
// unit for it; `description` explains what makes them special. `domain: Sea`
// units sail on water and can enter their own coastal cities; land units can
// embark onto water once their owner knows the techs for it (techs.ron).
// `upgrades_to` names the unit it can be upgraded to for gold inside its
// owner's borders; once the owner can build that one (or one further along
// the line), this one is no longer built. Unique units upgrade like the unit
// they replace.
(
    units: [
        (id: "settler", name: "Settler", class: Civilian, moves: 2, sight: 2, strength: 0, cost: 80,
         art: "settler", abilities: [FoundCity]),
        (id: "worker",  name: "Worker",  class: Civilian, moves: 2, sight: 2, strength: 0, cost: 40,
         art: "worker", abilities: [BuildImprovements]),
        (id: "merchant", name: "Merchant", class: Civilian, moves: 2, sight: 2, strength: 0, cost: 50,
         art: "merchant", abilities: [Trade], tech: Some("writing"),
         description: "A caravan that carries goods between a home city and another city, yours or a rival's at peace, and earns gold with every sale. Each city supports one Merchant, and one more with a Market."),
        (id: "scout",   name: "Scout",   class: Military, moves: 3, sight: 3, strength: 5, cost: 25,
         art: "scout", abilities: [IgnoreTerrainCost], upgrades_to: Some("explorer")),
        (id: "warrior", name: "Warrior", class: Military, moves: 2, sight: 2, strength: 10, cost: 40,
         art: "warrior", abilities: [], upgrades_to: Some("spearman")),
        (id: "slinger", name: "Slinger", class: Military, moves: 2, sight: 2, strength: 5, ranged: 7, range: 1, cost: 35,
         art: "slinger", upgrades_to: Some("archer"),
         description: "Stones hurled with a sling: a cheap ranged unit that strikes the next tile."),
        (id: "archer",  name: "Archer",  class: Military, moves: 2, sight: 2, strength: 6, ranged: 10, range: 2, cost: 50,
         art: "archer", abilities: [], tech: Some("archery"), upgrades_to: Some("composite_bowman")),
        (id: "spearman", name: "Spearman", class: Military, moves: 2, sight: 2, strength: 14, cost: 55,
         art: "spearman", abilities: [], tech: Some("bronze_working"), bonuses: [(percent: 50, when: VsMounted)],
         upgrades_to: Some("pikeman"),
         description: "Bronze-tipped spears: +50% against mounted units."),
        (id: "horseman", name: "Horseman", class: Military, moves: 4, sight: 2, strength: 12, cost: 60,
         art: "horseman", abilities: [Mounted], tech: Some("horseback_riding"), resource: Some("horses"),
         upgrades_to: Some("courser"),
         description: "Fast cavalry: 4 movement. Needs Horses."),
        (id: "chariot_archer", name: "Chariot Archer", class: Military, moves: 3, sight: 2, strength: 6, ranged: 12, range: 2, cost: 70,
         art: "chariot_archer", abilities: [Mounted], tech: Some("the_wheel"), resource: Some("horses"),
         bonuses: [(percent: 25, when: OpenGround)], upgrades_to: Some("knight"),
         description: "Archers on light chariots: 3 movement, +25% on open ground. Needs Horses."),
        (id: "swordsman", name: "Swordsman", class: Military, moves: 2, sight: 2, strength: 16, cost: 65,
         art: "swordsman", tech: Some("iron_working"), resource: Some("iron"), upgrades_to: Some("longswordsman"),
         description: "Iron-armed infantry, the strongest of its age. Needs Iron."),
        (id: "composite_bowman", name: "Composite Bowman", class: Military, moves: 2, sight: 2, strength: 8, ranged: 14, range: 2, cost: 75,
         art: "composite_bowman", tech: Some("mathematics"), upgrades_to: Some("crossbowman"),
         description: "Bows of horn, wood and sinew that outshoot the plain archer."),
        (id: "catapult", name: "Catapult", class: Military, moves: 2, sight: 2, strength: 4, ranged: 12, range: 2, cost: 70,
         art: "catapult", abilities: [], tech: Some("construction"), bonuses: [(percent: 100, when: AttackingCities)],
         upgrades_to: Some("trebuchet"),
         description: "Siege engine: double strength against cities, but helpless if caught in melee."),
        (id: "pikeman", name: "Pikeman", class: Military, moves: 2, sight: 2, strength: 22, cost: 90,
         art: "pikeman", tech: Some("feudalism"), bonuses: [(percent: 50, when: VsMounted)], upgrades_to: Some("musketman"),
         description: "A hedge of long pikes: +50% against mounted units."),
        (id: "crossbowman", name: "Crossbowman", class: Military, moves: 2, sight: 2, strength: 12, ranged: 20, range: 2, cost: 110,
         art: "crossbowman", tech: Some("machinery"), upgrades_to: Some("machine_gun"),
         description: "Mechanical bows that pierce armour."),
        (id: "courser", name: "Courser", class: Military, moves: 5, sight: 3, strength: 18, cost: 90,
         art: "courser", abilities: [Mounted], tech: Some("feudalism"), resource: Some("horses"), upgrades_to: Some("cavalry"),
         bonuses: [(percent: 25, when: OpenGround)],
         description: "Light cavalry on swift horses: 5 movement, sees far, +25% on open ground. Needs Horses."),
        (id: "knight", name: "Knight", class: Military, moves: 4, sight: 2, strength: 24, cost: 120,
         art: "knight", abilities: [Mounted], tech: Some("chivalry"), resource: Some("horses"), upgrades_to: Some("cuirassier"),
         description: "Armoured lancer: 4 movement. Needs Horses."),
        (id: "trebuchet", name: "Trebuchet", class: Military, moves: 2, sight: 2, strength: 6, ranged: 20, range: 2, cost: 120,
         art: "trebuchet", tech: Some("physics"), bonuses: [(percent: 100, when: AttackingCities)], upgrades_to: Some("cannon"),
         description: "Counterweight siege engine: double strength against cities, but helpless if caught in melee."),
        (id: "longswordsman", name: "Longswordsman", class: Military, moves: 2, sight: 2, strength: 26, cost: 120,
         art: "longswordsman", tech: Some("steel"), resource: Some("iron"), upgrades_to: Some("musketman"),
         description: "Heavy infantry in plate. Needs Iron."),
        (id: "musketman", name: "Musketman", class: Military, moves: 2, sight: 2, strength: 34, cost: 160,
         art: "musketman", tech: Some("gunpowder"), resource: Some("niter"), upgrades_to: Some("rifleman"),
         description: "Gunpowder infantry, the backbone of every army. Needs Niter."),
        (id: "cannon", name: "Cannon", class: Military, moves: 2, sight: 2, strength: 10, ranged: 30, range: 2, cost: 180,
         art: "cannon", tech: Some("metallurgy"), bonuses: [(percent: 100, when: AttackingCities)], upgrades_to: Some("artillery"),
         description: "Cast-bronze guns that bring down walls: double strength against cities, but helpless if caught in melee."),
        (id: "cuirassier", name: "Cuirassier", class: Military, moves: 4, sight: 2, strength: 32, cost: 170,
         art: "cuirassier", abilities: [Mounted], tech: Some("metallurgy"), resource: Some("horses"), upgrades_to: Some("cavalry"),
         description: "Heavy cavalry in breastplates with pistols and sabres: 4 movement. Needs Horses."),
        (id: "explorer", name: "Explorer", class: Military, moves: 4, sight: 3, strength: 8, cost: 45,
         art: "explorer", abilities: [IgnoreTerrainCost], tech: Some("astronomy"),
         description: "An expedition with maps and instruments: 4 movement over any ground."),
        (id: "rifleman", name: "Rifleman", class: Military, moves: 2, sight: 2, strength: 44, cost: 220,
         art: "rifleman", tech: Some("rifling"), upgrades_to: Some("infantry"),
         description: "Infantry with rifled muskets that shoot far and true."),
        (id: "cavalry", name: "Cavalry", class: Military, moves: 5, sight: 2, strength: 42, cost: 230,
         art: "cavalry", abilities: [Mounted], tech: Some("military_science"), resource: Some("horses"), upgrades_to: Some("tank"),
         bonuses: [(percent: 25, when: OpenGround)],
         description: "Sabres and carbines on fast horses: 5 movement, +25% on open ground. Needs Horses."),
        (id: "artillery", name: "Artillery", class: Military, moves: 2, sight: 2, strength: 14, ranged: 42, range: 3, cost: 260,
         art: "artillery", tech: Some("dynamite"), bonuses: [(percent: 100, when: AttackingCities)],
         description: "Breech-loading guns with explosive shells that hit three tiles away: double strength against cities, but helpless if caught in melee."),
        (id: "infantry", name: "Infantry", class: Military, moves: 2, sight: 2, strength: 58, cost: 300,
         art: "infantry", tech: Some("replaceable_parts"),
         description: "Riflemen in steel helmets with bolt-action rifles and grenades: the strongest infantry yet."),
        (id: "machine_gun", name: "Machine Gun", class: Military, moves: 2, sight: 2, strength: 40, ranged: 52, range: 2, cost: 300,
         art: "machine_gun", tech: Some("ballistics"),
         description: "A belt-fed gun and its crew: a wall of fire two tiles deep, strong in defence."),
        (id: "tank", name: "Tank", class: Military, moves: 5, sight: 2, strength: 72, cost: 400,
         art: "tank", abilities: [Mounted], tech: Some("mechanization"), resource: Some("oil"),
         bonuses: [(percent: 25, when: OpenGround)],
         description: "Armour, a gun in a turret and tracks: 5 movement, +25% on open ground. Needs Oil."),
        (id: "general", name: "General", class: Military, moves: 2, sight: 3, strength: 0, cost: 100,
         art: "general", abilities: [General], tech: Some("bronze_working"),
         description: "A commander who doesn't fight: your land units within 2 tiles fight 10% better and share his traits. He gains a level from their battles now and then, each a trait to choose (movement, sight, combat bonuses, healing). Shares a tile with a soldier."),
        (id: "galley", name: "Galley", class: Military, domain: Sea, moves: 3, sight: 2, strength: 12, cost: 50,
         art: "galley", tech: Some("sailing"), upgrades_to: Some("caravel"),
         description: "Oared warship: rams ships and embarked units, and raids the coast. Can't take cities."),
        (id: "quadrireme", name: "Quadrireme", class: Military, domain: Sea, moves: 3, sight: 2, strength: 8, ranged: 12, range: 2, cost: 70,
         art: "quadrireme", tech: Some("shipbuilding"), bonuses: [(percent: 25, when: AttackingCities)], upgrades_to: Some("frigate"),
         description: "Warship with a catapult on deck: bombards ships and coastal cities from two tiles away."),
        (id: "caravel", name: "Caravel", class: Military, domain: Sea, moves: 4, sight: 3, strength: 20, cost: 100,
         art: "caravel", tech: Some("compass"), upgrades_to: Some("galleon"),
         description: "Fast sailing ship that sees far: fights ships and embarked units. Can't take cities."),
        (id: "frigate", name: "Frigate", class: Military, domain: Sea, moves: 4, sight: 2, strength: 16, ranged: 28, range: 2, cost: 170,
         art: "frigate", tech: Some("navigation"), bonuses: [(percent: 25, when: AttackingCities)], upgrades_to: Some("ship_of_the_line"),
         description: "Broadside of cannon: bombards ships and coastal cities from two tiles away."),
        (id: "galleon", name: "Galleon", class: Military, domain: Sea, moves: 4, sight: 3, strength: 28, cost: 150,
         art: "galleon", tech: Some("navigation"), upgrades_to: Some("ironclad"),
         description: "Tall-sided ocean warship: boards ships and embarked units. Can't take cities."),
        (id: "ironclad", name: "Ironclad", class: Military, domain: Sea, moves: 5, sight: 2, strength: 42, cost: 240,
         art: "ironclad", tech: Some("steam_power"), resource: Some("coal"), upgrades_to: Some("destroyer"),
         description: "A steam warship in iron plate: rams and shells ships and embarked units. Can't take cities. Needs Coal."),
        (id: "ship_of_the_line", name: "Ship of the Line", class: Military, domain: Sea, moves: 4, sight: 2, strength: 24, ranged: 38, range: 2, cost: 250,
         art: "ship_of_the_line", tech: Some("steam_power"), bonuses: [(percent: 25, when: AttackingCities)], upgrades_to: Some("battleship"),
         description: "Two decks of heavy guns: bombards ships and coastal cities from two tiles away."),
        (id: "destroyer", name: "Destroyer", class: Military, domain: Sea, moves: 6, sight: 3, strength: 60, cost: 340,
         art: "destroyer", tech: Some("combustion"), resource: Some("oil"),
         description: "A fast, oil-fired escort with guns and torpedoes: 6 movement, sees far; hunts ships and embarked units. Can't take cities. Needs Oil."),
        (id: "battleship", name: "Battleship", class: Military, domain: Sea, moves: 5, sight: 2, strength: 40, ranged: 60, range: 3, cost: 400,
         art: "battleship", tech: Some("electronics"), resource: Some("oil"), bonuses: [(percent: 25, when: AttackingCities)],
         description: "Big guns in armoured turrets: bombards ships and coastal cities from three tiles away. Needs Oil."),

        // Unique units.
        (id: "schutter", name: "Schutter", class: Military, moves: 2, sight: 2, strength: 14, cost: 55,
         art: "spearman", tech: Some("bronze_working"), replaces: Some("spearman"),
         bonuses: [(percent: 30, when: OwnTerritory), (percent: 50, when: VsMounted)],
         description: "Citizen militia of the Dutch towns: +30% strength inside your borders, +50% against mounted units."),
        (id: "legion", name: "Legion", class: Military, moves: 2, sight: 2, strength: 17, cost: 65,
         art: "spearman", abilities: [BuildRoads], tech: Some("bronze_working"), replaces: Some("spearman"),
         bonuses: [(percent: 50, when: VsMounted)],
         description: "Heavy infantry: stronger than a Spearman, +50% against mounted units, and builds roads.",
         planned: Some("Can build forts.")),
        (id: "medjay", name: "Medjay", class: Military, moves: 3, sight: 3, strength: 9, cost: 35,
         art: "scout", abilities: [IgnoreTerrainCost], replaces: Some("scout"),
         description: "Desert police and scouts: fights almost like a Warrior."),
        (id: "keshig", name: "Keshig", class: Military, moves: 3, sight: 2, strength: 6, ranged: 10, range: 2, cost: 60,
         art: "archer", abilities: [Mounted], tech: Some("archery"), replaces: Some("archer"),
         description: "Mounted archer of the Khan's guard: 3 movement."),
        (id: "mandekalu", name: "Mandekalu", class: Military, moves: 3, sight: 2, strength: 11, cost: 50,
         art: "warrior", abilities: [Mounted], replaces: Some("warrior"), bonuses: [(percent: 25, when: OpenGround)],
         description: "Mounted spearmen of Mali: 3 movement, +25% on open ground."),
        (id: "huscarl", name: "Huscarl", class: Military, moves: 2, sight: 2, strength: 12, cost: 45,
         art: "warrior", replaces: Some("warrior"), bonuses: [(percent: 30, when: VsWounded)],
         description: "Household warriors: +30% against wounded enemies."),
        (id: "hwacha", name: "Hwacha", class: Military, moves: 2, sight: 2, strength: 5, ranged: 15, range: 2, cost: 60,
         art: "archer", abilities: [NoAttackAfterMove], tech: Some("archery"), replaces: Some("archer"),
         description: "Rocket launcher cart: a huge volley, but it can't fire after moving."),
        (id: "eagle_warrior", name: "Eagle Warrior", class: Military, moves: 2, sight: 2, strength: 12, cost: 45,
         art: "warrior", abilities: [CaptureAsWorker], replaces: Some("warrior"),
         description: "Elite warrior: destroying an enemy unit in melee gives you a Worker."),
        (id: "immortal", name: "Immortal", class: Military, moves: 2, sight: 2, strength: 14, cost: 60,
         art: "spearman", abilities: [FastHeal], tech: Some("bronze_working"), replaces: Some("spearman"),
         bonuses: [(percent: 50, when: VsMounted)],
         description: "The King's guard, always ten thousand strong: heals 10 extra hit points each turn, +50% against mounted units."),
        (id: "warak", name: "Warak'aq", class: Military, moves: 2, sight: 2, strength: 6, ranged: 9, range: 2, cost: 45,
         art: "archer", abilities: [AttackTwice], tech: Some("archery"), replaces: Some("archer"),
         description: "Andean slinger: cheap, and can attack twice per turn."),
        // Listed last so saves from before it still load (ids are positions).
        // Later unique units (Medieval to Industrial), one per civ.
        (id: "zeven_provincien", name: "De Zeven Provinciën", class: Military, domain: Sea, moves: 4, sight: 3, strength: 20, ranged: 32, range: 2, cost: 170,
         art: "frigate", tech: Some("navigation"), replaces: Some("frigate"), bonuses: [(percent: 50, when: AttackingCities)],
         description: "De Ruyter's flagship and her sisters: a stronger broadside, sees further, and +50% against cities."),
        (id: "ballista", name: "Ballista", class: Military, moves: 2, sight: 2, strength: 6, ranged: 14, range: 2, cost: 70,
         art: "catapult", tech: Some("construction"), replaces: Some("catapult"), bonuses: [(percent: 100, when: AttackingCities), (percent: 25, when: AttackingUnits)],
         description: "Roman torsion engine: shoots harder than a Catapult, double strength against cities and +25% against units."),
        (id: "mamluk", name: "Mamluk", class: Military, moves: 4, sight: 2, strength: 26, cost: 120,
         art: "knight", abilities: [Mounted, FastHeal], tech: Some("chivalry"), resource: Some("horses"), replaces: Some("knight"),
         description: "Slave soldiers raised to be the finest horsemen of their age: stronger than a Knight, and heal 10 extra hit points a turn. Needs Horses."),
        (id: "tumen", name: "Tumen", class: Military, moves: 5, sight: 3, strength: 18, cost: 90,
         art: "courser", abilities: [Mounted], tech: Some("feudalism"), resource: Some("horses"), replaces: Some("courser"),
         bonuses: [(percent: 25, when: OpenGround), (percent: 25, when: VsWounded)],
         description: "A ten-thousand of steppe riders: 5 movement, +25% on open ground and +25% against wounded enemies. Needs Horses."),
        (id: "sofa", name: "Sofa", class: Military, moves: 3, sight: 2, strength: 36, cost: 160,
         art: "musketman", tech: Some("gunpowder"), resource: Some("niter"), replaces: Some("musketman"),
         description: "Mali's professional gunmen: stronger than a Musketman, and 3 movement. Needs Niter."),
        (id: "varangian", name: "Varangian Guard", class: Military, moves: 2, sight: 2, strength: 28, cost: 120,
         art: "longswordsman", tech: Some("steel"), resource: Some("iron"), replaces: Some("longswordsman"),
         bonuses: [(percent: 25, when: Coastal)],
         description: "Norse axemen who guarded the emperors of Byzantium: stronger than a Longswordsman, +25% by the water. Needs Iron."),
        (id: "turtle_ship", name: "Turtle Ship", class: Military, domain: Sea, moves: 4, sight: 2, strength: 28, cost: 110,
         art: "caravel", tech: Some("compass"), replaces: Some("caravel"), bonuses: [(percent: 25, when: Coastal)],
         description: "An armoured, spiked deck no boarder could take: much stronger than a Caravel, +25% near the coast. Can't take cities."),
        (id: "jaguar_warrior", name: "Jaguar Warrior", class: Military, moves: 2, sight: 2, strength: 16, cost: 60,
         art: "swordsman", abilities: [CaptureAsWorker], tech: Some("iron_working"), replaces: Some("swordsman"),
         description: "Elite warriors in jaguar skins: fights like a Swordsman without needing Iron, and takes captives as Workers."),
        (id: "qizilbash", name: "Qizilbash", class: Military, moves: 4, sight: 2, strength: 32, cost: 160,
         art: "cuirassier", abilities: [Mounted, FastHeal], tech: Some("metallurgy"), resource: Some("horses"), replaces: Some("cuirassier"),
         bonuses: [(percent: 15, when: AttackingUnits)],
         description: "The Safavid shah's red-capped cavalry: +15% when attacking units, and heal 10 extra hit points a turn. Needs Horses."),
        (id: "chasqui", name: "Chasqui", class: Military, moves: 5, sight: 3, strength: 8, cost: 40,
         art: "explorer", abilities: [IgnoreTerrainCost], tech: Some("astronomy"), replaces: Some("explorer"),
         description: "The Inca's relay runners: 5 movement over any ground."),
        (id: "admiral", name: "Admiral", class: Military, domain: Sea, moves: 4, sight: 3, strength: 0, cost: 100,
         art: "admiral", abilities: [General], tech: Some("sailing"),
         description: "A flag officer on a fast flagship who doesn't fight: your ships within 2 tiles fight 10% better and share his traits. He gains a level from their battles now and then, each a trait to choose. Shares a tile with a ship."),
    ],
)
