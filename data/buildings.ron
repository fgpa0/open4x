// City buildings. Yields are added to the city each turn; culture grows borders;
// defense (percent) will strengthen the city against attack; `tech` is the
// technology that unlocks the building (none: available from the start).
// `keeps_food` (percent) is food kept when the city grows; `city_range` lets
// the city fire at enemies that far away each turn; `tile_bonus` adds yields to
// matching worked tiles; `heals_units` fully heals units in the city each
// turn; `military_production` (percent) speeds up units and `unit_xp` gives
// them experience when trained or bought, both for the `units` given
// (Military: all, the default; Land, Sea or Mounted); `trade_gold` (percent)
// adds to the gold of trade routes from or to the city. `requires` is a building the
// city needs first (or a civ's replacement for it); `coastal` ones go only in
// cities next to water. Buildings with `replaces` are unique to one
// civilization (see civs.ron).
(
    buildings: [
        (id: "monument", name: "Monument", cost: 40, culture: 2,
         description: "Spreads your culture: borders grow faster."),
        (id: "granary",  name: "Granary",  cost: 60, food: 2, keeps_food: 50, tech: Some("pottery"),
         description: "+2 food. The city keeps half its food when it grows."),
        (id: "workshop", name: "Workshop", cost: 70, production: 2, tech: Some("mining"),
         description: "+2 production."),
        (id: "shrine",   name: "Shrine",   cost: 35, culture: 1, science: 1, tech: Some("calendar"),
         description: "A small sanctuary: +1 culture and +1 science."),
        (id: "barracks", name: "Barracks", cost: 50, unit_xp: 12, units: Land, tech: Some("bronze_working"),
         description: "Drill grounds: land units trained or bought here start as Veterans."),
        (id: "lighthouse", name: "Lighthouse", cost: 55, gold: 1, unit_xp: 12, units: Sea, tech: Some("sailing"), coastal: true,
         description: "+1 gold, and ships built or bought here start as Veterans."),
        (id: "stable",   name: "Stable",   cost: 60, production: 1, military_production: 25, units: Mounted, tech: Some("horseback_riding"),
         description: "+1 production, and mounted units are built 25% faster."),
        (id: "market",   name: "Market",   cost: 80, gold: 3, trade_gold: 25, tech: Some("currency"),
         description: "+3 gold. Trade routes from or to the city earn 25% more."),
        (id: "walls",    name: "Walls",    cost: 60, defense: 50, city_range: 2, tech: Some("masonry"),
         description: "+50% defense for the city, and it fires at enemies within 2 tiles every turn."),
        (id: "library",  name: "Library",  cost: 65, science: 3, tech: Some("writing"),
         description: "+3 science."),
        (id: "amphitheater", name: "Amphitheater", cost: 90, culture: 3, tech: Some("construction"),
         description: "+3 culture: borders grow much faster."),
        (id: "temple",   name: "Temple",   cost: 100, culture: 2, science: 2, tech: Some("philosophy"),
         description: "+2 culture and +2 science."),
        (id: "harbor",   name: "Harbor",   cost: 110, tech: Some("optics"), coastal: true,
         tile_bonus: Some((when: [Terrain("coast")], food: 1)),
         description: "+1 food for each worked Coast tile."),
        (id: "aqueduct", name: "Aqueduct", cost: 140, food: 3, tech: Some("engineering"),
         description: "Fresh water: +3 food."),
        (id: "university", name: "University", cost: 180, science: 5, tech: Some("education"), requires: Some("library"),
         description: "+5 science. Needs a Library."),
        (id: "armory",   name: "Armory",   cost: 130, military_production: 25, unit_xp: 12, units: Land, tech: Some("feudalism"), requires: Some("barracks"),
         description: "Land units are built 25% faster and gain more experience in training: with the Barracks, they start close to Elite. Needs Barracks."),
        (id: "caravanserai", name: "Caravanserai", cost: 120, gold: 2, trade_gold: 25, tech: Some("guilds"),
         description: "An inn for caravans: +2 gold, and trade routes from or to the city earn 25% more."),
        (id: "castle",   name: "Castle",   cost: 160, defense: 25, city_range: 2, tech: Some("chivalry"), requires: Some("walls"),
         description: "+25% defense on top of the walls. Needs Walls."),
        (id: "observatory", name: "Observatory", cost: 240, science: 6, tech: Some("astronomy"), requires: Some("university"),
         description: "+6 science. Needs a University."),
        (id: "bank",     name: "Bank",     cost: 220, gold: 5, tech: Some("banking"), requires: Some("market"),
         description: "+5 gold. Needs a Market."),
        (id: "shipyard", name: "Shipyard", cost: 180, production: 2, military_production: 25, units: Sea, tech: Some("navigation"), coastal: true,
         requires: Some("harbor"),
         description: "Dry docks and slipways: +2 production, and ships are built 25% faster. Needs a Harbor."),
        (id: "opera_house", name: "Opera House", cost: 200, culture: 4, tech: Some("architecture"), requires: Some("amphitheater"),
         description: "+4 culture. Needs an Amphitheater."),
        (id: "factory",  name: "Factory",  cost: 320, production: 5, tech: Some("industrialization"), requires: Some("workshop"), resource: Some("coal"),
         description: "Coal-fired mills: +5 production. Needs a Workshop, and Coal to build."),
        (id: "stock_exchange", name: "Stock Exchange", cost: 300, gold: 6, trade_gold: 25, tech: Some("economics"), requires: Some("bank"),
         description: "+6 gold, and trade routes from or to the city earn 25% more. Needs a Bank."),
        (id: "public_school", name: "Public School", cost: 300, science: 6, tech: Some("scientific_theory"), requires: Some("university"),
         description: "+6 science. Needs a University."),
        (id: "museum",   name: "Museum",   cost: 280, culture: 6, tech: Some("archaeology"), requires: Some("opera_house"),
         description: "+6 culture. Needs an Opera House."),
        (id: "military_academy", name: "Military Academy", cost: 260, military_production: 25, unit_xp: 12, units: Land, tech: Some("military_science"), requires: Some("armory"),
         description: "Land units are built 25% faster and start with more experience: with the Barracks and Armory, they start as Elites. Needs an Armory."),
        (id: "star_fort", name: "Star Fort", cost: 260, defense: 25, city_range: 3, tech: Some("metallurgy"), requires: Some("castle"),
         description: "Low angled bastions: +25% defense on top of the castle, and the city fires at enemies within 3 tiles. Needs a Castle."),
        (id: "arsenal",  name: "Arsenal",  cost: 340, defense: 25, city_range: 3, tech: Some("dynamite"), requires: Some("star_fort"),
         description: "Earthworks, magazines and heavy guns: +25% defense on top of the star fort. Needs a Star Fort."),
        (id: "hospital", name: "Hospital", cost: 360, food: 4, tech: Some("sanitation"), requires: Some("aqueduct"),
         description: "Doctors, nurses and clean wards: +4 food. Needs an Aqueduct."),
        (id: "supermarket", name: "Supermarket", cost: 340, food: 2, tech: Some("refrigeration"),
         tile_bonus: Some((when: [Improvement("farm")], food: 1)),
         description: "Refrigerated food from far and wide: +2 food, and +1 food for each worked Farm."),
        (id: "power_plant", name: "Power Plant", cost: 420, production: 6, tech: Some("electronics"), requires: Some("factory"), resource: Some("oil"),
         description: "Oil-fired turbines that light the city: +6 production. Needs a Factory, and Oil to build."),
        (id: "military_base", name: "Military Base", cost: 400, defense: 25, city_range: 3, tech: Some("ballistics"), requires: Some("arsenal"),
         description: "Bunkers, barbed wire and coastal guns: +25% defense on top of the arsenal. Needs an Arsenal."),
        (id: "broadcast_tower", name: "Broadcast Tower", cost: 380, culture: 8, tech: Some("radio"), requires: Some("museum"),
         description: "Music, news and plays on the air: +8 culture. Needs a Museum."),
        (id: "research_lab", name: "Research Lab", cost: 440, science: 8, tech: Some("plastics"), requires: Some("public_school"),
         description: "Laboratories for industry and the state: +8 science. Needs a Public School."),

        // Unique buildings.
        (id: "waag",     name: "Waag",     cost: 80, gold: 3, trade_gold: 25, tech: Some("currency"), replaces: Some("market"),
         tile_bonus: Some((when: [Terrain("coast")], gold: 1)),
         description: "Weigh house: +3 gold, and +1 gold for each worked Coast tile. Trade routes from or to the city earn 25% more."),
        (id: "forum",    name: "Forum",    cost: 45, culture: 2, gold: 2, replaces: Some("monument"),
         description: "+2 culture and +2 gold."),
        (id: "mortuary_temple", name: "Mortuary Temple", cost: 100, culture: 3, science: 2, production: 1, tech: Some("philosophy"),
         replaces: Some("temple"),
         description: "+3 culture, +2 science and +1 production."),
        (id: "ordu",     name: "Ordu",     cost: 60, military_production: 25, heals_units: true, tech: Some("masonry"), replaces: Some("walls"),
         description: "Mobile camp instead of walls: no extra defense, but units in the city heal fully each turn, and units are built 25% faster."),
        (id: "sankore",  name: "Sankore Madrasa", cost: 65, science: 3, gold: 2, tech: Some("writing"), replaces: Some("library"),
         description: "+3 science and +2 gold."),
        (id: "longhouse", name: "Longhouse", cost: 70, production: 2, tech: Some("mining"), replaces: Some("workshop"),
         tile_bonus: Some((when: [Feature("forest")], production: 1)),
         description: "+2 production, and +1 production for each worked Forest."),
        (id: "hwaseong", name: "Hwaseong", cost: 80, defense: 75, city_range: 3, tech: Some("masonry"), replaces: Some("walls"),
         description: "Fortress walls: +75% defense, and the city fires at enemies within 3 tiles every turn."),
        (id: "tlachtli", name: "Tlachtli", cost: 90, culture: 3, production: 1, tech: Some("construction"), replaces: Some("amphitheater"),
         description: "Ball court: +3 culture and +1 production."),
        (id: "pairidaeza", name: "Pairidaeza", cost: 100, culture: 2, science: 2, gold: 2, tech: Some("philosophy"), replaces: Some("temple"),
         description: "Walled paradise garden: +2 culture, +2 science and +2 gold."),
        (id: "qullqa",   name: "Qullqa",   cost: 60, food: 2, keeps_food: 75, tech: Some("pottery"), replaces: Some("granary"),
         description: "Storehouse: +2 food. The city keeps three quarters of its food when it grows."),
    ],
)
