// Technologies. `cost` is science points; `requires` lists prerequisites,
// which must appear earlier in this file. Each tech belongs to an `era` from
// `eras` (never earlier than its prerequisites', and listed in era order); a
// player's era is the latest one they know a tech of. Every tech of an era
// also needs every tech of the era before it. Units and buildings name the tech that unlocks
// them with `tech: Some("...")` in their own files. `grants` are abilities for
// all of a player's units: `Embark` lets land units take to shallow water
// (coast and lakes) and `DeepWater` lets every unit cross the ocean. `effects`
// are lasting bonuses for whoever knows the tech, written like civ perks
// (see civs.ron).
(
    eras: [
        (id: "ancient", name: "Ancient Era"),
        (id: "classical", name: "Classical Era"),
        (id: "medieval", name: "Medieval Era"),
        (id: "renaissance", name: "Renaissance"),
        (id: "industrial", name: "Industrial Era"),
        (id: "modern", name: "Modern Era"),
    ],
    techs: [
        // Ancient.
        (id: "pottery", name: "Pottery", era: "ancient", cost: 20,
         description: "Storing food through lean seasons."),
        (id: "mining", name: "Mining", era: "ancient", cost: 20,
         description: "Digging stone and ore from the hills."),
        (id: "archery", name: "Archery", era: "ancient", cost: 25,
         description: "Striking from a distance."),
        (id: "sailing", name: "Sailing", era: "ancient", cost: 30, grants: [Embark],
         description: "Boats along the coast."),
        (id: "animal_husbandry", name: "Animal Husbandry", era: "ancient", cost: 25,
         description: "Herds, pastures and the hunt. Reveals horses."),
        (id: "writing", name: "Writing", era: "ancient", cost: 40, requires: ["pottery"],
         description: "Records and contracts that outlive their authors: merchants."),
        (id: "calendar", name: "Calendar", era: "ancient", cost: 40, requires: ["pottery"],
         description: "Planting by the seasons: plantations."),
        (id: "horseback_riding", name: "Horseback Riding", era: "ancient", cost: 45, requires: ["animal_husbandry"],
         description: "Fast riders on tamed horses."),
        (id: "masonry", name: "Masonry", era: "ancient", cost: 40, requires: ["mining"],
         description: "Cut stone for lasting walls."),
        (id: "bronze_working", name: "Bronze Working", era: "ancient", cost: 45, requires: ["mining"],
         description: "Alloyed metal for tools and spears. Reveals iron."),

        // Classical.
        (id: "the_wheel", name: "The Wheel", era: "classical", cost: 70, requires: ["horseback_riding"],
         description: "Light chariots carrying archers."),
        (id: "iron_working", name: "Iron Working", era: "classical", cost: 70, requires: ["bronze_working"],
         description: "Iron blades for heavy infantry."),
        (id: "mathematics", name: "Mathematics", era: "classical", cost: 80, requires: ["writing", "masonry"],
         description: "Geometry for builders and the arc of an arrow."),
        (id: "currency", name: "Currency", era: "classical", cost: 80, requires: ["writing"],
         effects: [TradeGold(25)],
         description: "Coins make trade easy: +25% gold from trade routes."),
        (id: "shipbuilding", name: "Shipbuilding", era: "classical", cost: 90, requires: ["sailing", "bronze_working"], grants: [DeepWater],
         description: "Hulls strong enough for the open sea."),
        (id: "construction", name: "Construction", era: "classical", cost: 90, requires: ["masonry", "bronze_working"],
         description: "Arches, great public buildings, bridges over straits and canals between seas."),
        (id: "optics", name: "Optics", era: "classical", cost: 110, requires: ["sailing", "mathematics"],
         description: "Lenses and lighthouses: harbors for coastal cities."),
        (id: "philosophy", name: "Philosophy", era: "classical", cost: 120, requires: ["currency"],
         description: "Asking why, and teaching others to ask."),
        (id: "engineering", name: "Engineering", era: "classical", cost: 150, requires: ["construction", "mathematics"],
         description: "Aqueducts bring fresh water to growing cities, and tunnels cut through mountains."),

        // Medieval.
        (id: "feudalism", name: "Feudalism", era: "medieval", cost: 340, requires: ["iron_working", "philosophy"],
         description: "Lords, vassals and levies of pikemen."),
        (id: "civil_service", name: "Civil Service", era: "medieval", cost: 360, requires: ["philosophy"],
         effects: [TileYield(when: [Improvement("farm")], food: 1)],
         description: "Officials who keep the canals dug: +1 food on every Farm."),
        (id: "compass", name: "Compass", era: "medieval", cost: 360, requires: ["optics", "shipbuilding"],
         description: "Steering by the needle: caravels."),
        (id: "machinery", name: "Machinery", era: "medieval", cost: 380, requires: ["engineering"],
         description: "Gears and cranks: crossbows and lumber mills."),
        (id: "education", name: "Education", era: "medieval", cost: 400, requires: ["philosophy", "mathematics"],
         description: "The first universities."),
        (id: "chivalry", name: "Chivalry", era: "medieval", cost: 420, requires: ["feudalism", "horseback_riding"],
         description: "Armoured knights and stone castles."),
        (id: "guilds", name: "Guilds", era: "medieval", cost: 420, requires: ["currency", "civil_service"],
         effects: [BuildingBonus(building: "market", gold: 2), BuildingBonus(building: "workshop", production: 1)],
         description: "Craftsmen organise: +2 gold from every Market and +1 production from every Workshop."),
        (id: "physics", name: "Physics", era: "medieval", cost: 440, requires: ["engineering", "education"],
         description: "Counterweights and trajectories: trebuchets. Reveals niter."),
        (id: "steel", name: "Steel", era: "medieval", cost: 460, requires: ["iron_working", "machinery"],
         description: "Tempered blades for longswordsmen."),

        // Renaissance.
        (id: "astronomy", name: "Astronomy", era: "renaissance", cost: 2200, requires: ["education", "compass"],
         description: "Charting the heavens: observatories."),
        (id: "banking", name: "Banking", era: "renaissance", cost: 2300, requires: ["guilds", "education"],
         description: "Credit and interest: banks."),
        (id: "printing_press", name: "Printing Press", era: "renaissance", cost: 2400, requires: ["education", "guilds"],
         effects: [BuildingBonus(building: "library", science: 2)],
         description: "Books for everyone: +2 science from every Library."),
        (id: "gunpowder", name: "Gunpowder", era: "renaissance", cost: 2600, requires: ["steel", "physics"],
         description: "Muskets that need niter."),
        (id: "navigation", name: "Navigation", era: "renaissance", cost: 2600, requires: ["astronomy"],
         description: "Frigates that rule the seas."),
        (id: "architecture", name: "Architecture", era: "renaissance", cost: 2900, requires: ["printing_press", "engineering"],
         effects: [BuildingProduction(percent: 25, min_population: 1)],
         description: "Domes and grand designs: buildings go up 25% faster."),
        (id: "metallurgy", name: "Metallurgy", era: "renaissance", cost: 3200, requires: ["gunpowder"],
         description: "Cast bronze cannon, and star forts to stand against them."),

        // Industrial.
        (id: "industrialization", name: "Industrialization", era: "industrial", cost: 3900, requires: ["banking", "architecture"],
         description: "Steam-driven mills: factories that burn coal. Reveals coal."),
        (id: "scientific_theory", name: "Scientific Theory", era: "industrial", cost: 3900, requires: ["astronomy", "printing_press"],
         effects: [BuildingBonus(building: "university", science: 2)],
         description: "The method of experiment: public schools, and +2 science from every University."),
        (id: "economics", name: "Economics", era: "industrial", cost: 4000, requires: ["banking", "printing_press"],
         effects: [BuildingBonus(building: "bank", gold: 2)],
         description: "Joint-stock companies: stock exchanges, and +2 gold from every Bank."),
        (id: "rifling", name: "Rifling", era: "industrial", cost: 4000, requires: ["metallurgy"],
         description: "Grooved barrels that shoot true: riflemen."),
        (id: "archaeology", name: "Archaeology", era: "industrial", cost: 4200, requires: ["scientific_theory"],
         description: "Digging up the past: museums."),
        (id: "steam_power", name: "Steam Power", era: "industrial", cost: 4300, requires: ["industrialization", "navigation"],
         description: "Engines at sea: ironclads that need coal, and ships of the line."),
        (id: "military_science", name: "Military Science", era: "industrial", cost: 4500, requires: ["rifling", "economics"],
         description: "Staff colleges and drill: cavalry and military academies."),
        (id: "railroad", name: "Railroad", era: "industrial", cost: 4600, requires: ["steam_power"],
         description: "Iron roads: Workers lay railways over roads, and a step along one costs a fifth of a move."),
        (id: "electricity", name: "Electricity", era: "industrial", cost: 4800, requires: ["scientific_theory", "steam_power"],
         effects: [BuildingBonus(building: "workshop", production: 2)],
         description: "Dynamos and wires: +2 production from every Workshop."),
        (id: "dynamite", name: "Dynamite", era: "industrial", cost: 5000, requires: ["military_science", "industrialization"],
         description: "High explosives: artillery, and arsenals to stand against it."),
        // Modern.
        (id: "replaceable_parts", name: "Replaceable Parts", era: "modern", cost: 4800, requires: ["military_science", "electricity"],
         description: "Interchangeable parts by the million: infantry."),
        (id: "sanitation", name: "Sanitation", era: "modern", cost: 4800, requires: ["economics", "scientific_theory"],
         description: "Sewers, clean water and germ theory: hospitals."),
        (id: "combustion", name: "Combustion", era: "modern", cost: 5000, requires: ["railroad", "dynamite"],
         description: "Engines that burn oil: destroyers that need it, and oil wells. Reveals oil."),
        (id: "refrigeration", name: "Refrigeration", era: "modern", cost: 5200, requires: ["electricity", "sanitation"],
         effects: [BuildingBonus(building: "harbor", food: 2)],
         description: "Cold stores and refrigerated ships: supermarkets, and +2 food from every Harbor."),
        (id: "electronics", name: "Electronics", era: "modern", cost: 5200, requires: ["electricity", "combustion"],
         description: "Valves and turbines: power plants that burn oil, and battleships."),
        (id: "ballistics", name: "Ballistics", era: "modern", cost: 5400, requires: ["replaceable_parts", "dynamite"],
         description: "The science of the shell's flight: machine guns, and military bases."),
        (id: "radio", name: "Radio", era: "modern", cost: 5600, requires: ["electronics"],
         description: "Voices on the air: broadcast towers."),
        (id: "mass_production", name: "Mass Production", era: "modern", cost: 5800, requires: ["replaceable_parts", "electronics"],
         effects: [BuildingBonus(building: "factory", production: 3)],
         description: "The assembly line: +3 production from every Factory."),
        (id: "plastics", name: "Plastics", era: "modern", cost: 6000, requires: ["refrigeration", "electronics"],
         description: "Materials made from oil: research laboratories."),
        (id: "mechanization", name: "Mechanization", era: "modern", cost: 6200, requires: ["combustion", "ballistics"],
         description: "Armour on tracks: tanks that need oil."),
    ],
)
