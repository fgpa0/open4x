        (
            id: "inca",
            name: "Inca",
            adjective: "Inca",
            leader: "Pachacuti",
            leader_title: "Earth-Shaker",
            colors: (primary: (204, 64, 140), secondary: (250, 216, 80)),
            emblem: "chakana",
            description: "An empire strung along the spine of the Andes. Pachacuti rebuilt Cusco, terraced the mountainsides and bound four regions together with roads and runners.",
            start_bias: [Mountains, Hills],
            home: Some((-72.0, -13.5)), // Cusco
            drives: (expansion: 7, military: 5, opportunism: 3, grudge: 6, risk: 4, patience: 6, builder: 8, wealth: 3, science: 4, defense: 7, seafaring: 1),
            army: (melee: 5, ranged: 8, cavalry: 0, siege: 3),
            agenda: (kind: Tawantinsuyu, name: "Tawantinsuyu",
                description: "Wants to absorb small neighbours (two cities or fewer). Leaves civilizations as large as its own alone."),
            ability: (name: "Terraces",
                description: "Tiles next to mountains yield +1 food.",
                effects: [TileYield(when: [NearMountain], food: 1)]),
            leader_ability: (name: "Qhapaq Ñan",
                description: "Inside Inca borders, every land tile costs units only 1 movement.",
                effects: [IgnoreTerrainInTerritory]),
            unique_units: ["warak", "chasqui"],
            unique_buildings: ["qullqa"],
            cities: ["Cusco", "Tiwanaku", "Machu Picchu", "Ollantaytambo", "Quito", "Cajamarca", "Huánuco Pampa", "Vilcabamba", "Pisac", "Tumbes", "Chan Chan", "Huamanga", "Tomebamba", "Vitcos", "Choquequirao", "Sacsayhuamán"],
            generals: ["Túpac Yupanqui", "Rumiñawi", "Quizquiz", "Chalcuchímac", "Ollantay", "Manco Inca"],
            admirals: ["Apu Mayta", "Huaman Achachi", "Kusi Yupanki", "Apu Kamaq", "Inka Roqa", "Sinchi Roqa"],
