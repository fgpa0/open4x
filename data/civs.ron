// Civilizations and their leaders.
//
// `colors` are sRGB: `primary` for units, borders and banners, `secondary` for
// emblems and trim. `emblem` names a drawing in the client (`icons.rs`).
// `start_bias` lists what the civ likes near its starting tile, most important
// first; Desert, Tundra, Taiga and Jungle also drop the usual preference for a
// temperate climate.
// `home` is where the civ arose, as (longitude, latitude): its start on the
// Earth map with True Start Locations (see earth.ron).
//
// `drives` (0..10) steer the computer player. No single value means
// "aggressive"; wars come from combinations (land hunger when boxed in,
// opportunism against weak armies, grudges...) plus the leader's `agenda`.
//
// `army` weighs the troops the AI builds for this leader (0..10: infantry,
// ranged, cavalry, and siege engines when besieging), after their history.
//
// `ability` and `leader_ability` are perks: `effects` are what the simulation
// applies; `planned` describes parts that need systems the game doesn't have
// yet (shown as "coming later"). Unique units and buildings are defined in
// units.ron and buildings.ron with a `replaces` field and listed here.
// `generals` names the Generals the civ trains, in order, and `admirals` its
// Admirals.
(
    civs: [
        (
            id: "netherlands",
            name: "Netherlands",
            adjective: "Dutch",
            leader: "William the Silent",
            leader_title: "Father of the Fatherland",
            colors: (primary: (238, 122, 20), secondary: (24, 52, 122)),
            emblem: "windmill",
            description: "A nation that made its own land. Behind dikes and canals the Dutch grew rich on trade and the sea, and anyone who tried to take it from them met water where there had been fields.",
            start_bias: [Coast, Marsh, River],
            home: Some((4.9, 52.4)), // Amsterdam
            drives: (expansion: 4, military: 3, opportunism: 2, grudge: 8, risk: 3, patience: 8, builder: 6, wealth: 9, science: 6, defense: 9, seafaring: 9),
            army: (melee: 6, ranged: 5, cavalry: 2, siege: 3),
            agenda: (kind: MercantileRival, name: "Mercantile Rival",
                description: "Grows hostile towards anyone who settles near its coast or out-earns it. Slow to start a war, but holds the longest grudges of anyone."),
            ability: (name: "Polders",
                description: "Coast, lake and marsh tiles yield +1 production. Coastal cities get +1 food.",
                effects: [
                    TileYield(when: [Terrain("coast")], production: 1),
                    TileYield(when: [Terrain("lake")], production: 1),
                    TileYield(when: [Feature("marsh")], production: 1),
                    CityYield(when: Coastal, food: 1),
                ]),
            leader_ability: (name: "Dutch Water Line",
                description: "Enemy units on flat land next to a river or the sea inside Dutch borders fight at -25%.",
                effects: [EnemyCombat(percent: -25, when: InOwnLowlands)],
                planned: Some("Once per war, flood your lowlands for 5 turns: enemies entering them lose all their movement.")),
            unique_units: ["schutter", "zeven_provincien"],
            unique_buildings: ["waag"],
            cities: ["Amsterdam", "Rotterdam", "Den Haag", "Utrecht", "Leiden", "Haarlem", "Delft", "Groningen", "Middelburg", "Dordrecht", "Nijmegen", "Zwolle", "Maastricht", "Alkmaar", "Hoorn", "Deventer"],
            generals: ["Maurice of Nassau", "Frederick Henry", "Menno van Coehoorn", "Ernst Casimir", "John William Friso", "Henry Casimir"],
            admirals: ["Michiel de Ruyter", "Maarten Tromp", "Piet Hein", "Cornelis Tromp", "Witte de With", "Jacob van Heemskerck"],
        ),
        (
            id: "rome",
            name: "Rome",
            adjective: "Roman",
            leader: "Augustus",
            leader_title: "First Citizen",
            colors: (primary: (186, 32, 40), secondary: (246, 206, 96)),
            emblem: "laurel",
            description: "A city that became a world. Rome expanded by road, law and legion, and Augustus boasted he found it a city of brick and left it one of marble.",
            start_bias: [River, Hills],
            home: Some((12.5, 41.9)), // Rome
            drives: (expansion: 9, military: 6, opportunism: 5, grudge: 5, risk: 5, patience: 6, builder: 8, wealth: 5, science: 4, defense: 5, seafaring: 3),
            army: (melee: 9, ranged: 3, cavalry: 2, siege: 7),
            agenda: (kind: PaxRomana, name: "Pax Romana",
                description: "Wants one unbroken realm. Goes to war with whoever plants cities inside its sphere or boxes it in: land hunger, not bloodlust."),
            ability: (name: "All Roads Lead to Rome",
                description: "Every new city starts with a free Forum and a road to the capital.",
                effects: [FreeBuilding("monument"), RoadToCapital]),
            leader_ability: (name: "City of Marble",
                description: "+15% production towards buildings in cities with 4 or more citizens.",
                effects: [BuildingProduction(percent: 15, min_population: 4)]),
            unique_units: ["legion", "ballista"],
            unique_buildings: ["forum"],
            cities: ["Roma", "Antium", "Cumae", "Neapolis", "Ravenna", "Arretium", "Mediolanum", "Capua", "Brundisium", "Tarentum", "Pisae", "Aquileia", "Verona", "Ostia", "Genua", "Arpinum"],
            generals: ["Scipio Africanus", "Germanicus", "Marius", "Pompey", "Camillus", "Aetius"],
            admirals: ["Agrippa", "Gaius Duilius", "Lutatius Catulus", "Sextus Pompey", "Pliny the Elder", "Atilius Regulus"],
        ),
        (
            id: "egypt",
            name: "Egypt",
            adjective: "Egyptian",
            leader: "Hatshepsut",
            leader_title: "Foremost of Noble Ladies",
            colors: (primary: (232, 196, 64), secondary: (32, 72, 150)),
            emblem: "ankh",
            description: "A ribbon of green through the desert. Hatshepsut ruled in peace and plenty, sent ships to the land of Punt and raised temples that still stand.",
            start_bias: [Desert, River],
            home: Some((31.2, 29.9)), // Memphis, at the head of the Nile delta
            drives: (expansion: 5, military: 3, opportunism: 3, grudge: 6, risk: 2, patience: 7, builder: 10, wealth: 8, science: 5, defense: 6, seafaring: 4),
            army: (melee: 4, ranged: 6, cavalry: 6, siege: 3),
            agenda: (kind: RiverWarden, name: "River Warden",
                description: "Peaceful by nature, but fights hard for control of any river its cities stand on."),
            ability: (name: "Gift of the Nile",
                description: "River tiles yield +1 food. Desert tiles on a river yield another +1 food.",
                effects: [
                    TileYield(when: [River], food: 1),
                    TileYield(when: [Terrain("desert"), River], food: 1),
                ]),
            leader_ability: (name: "Expedition to Punt",
                description: "Markets also yield +1 food. Trade routes earn 25% more gold.",
                effects: [BuildingBonus(building: "market", food: 1), TradeGold(25)]),
            unique_units: ["medjay", "mamluk"],
            unique_buildings: ["mortuary_temple"],
            cities: ["Thebes", "Memphis", "Heliopolis", "Elephantine", "Pi-Ramesses", "Giza", "Abydos", "Akhetaten", "Hierakonpolis", "Asyut", "Avaris", "Edfu", "Buto", "Lisht", "Dendera", "Kom Ombo"],
            generals: ["Thutmose", "Ahmose", "Ramesses", "Horemheb", "Seqenenre", "Amenemhat"],
            admirals: ["Ahmose son of Ebana", "Nehesy", "Khnumhotep", "Weni", "Paser", "Iuny"],
        ),
        (
            id: "mongols",
            name: "Mongols",
            adjective: "Mongol",
            leader: "Genghis Khan",
            leader_title: "Universal Ruler",
            colors: (primary: (96, 178, 232), secondary: (250, 226, 120)),
            emblem: "bow",
            description: "Horsemen of the endless steppe. Riders of the Örtöö carried orders across a continent, and cities that would not submit were not spared.",
            start_bias: [Plains, Grassland],
            home: Some((102.8, 47.2)), // Karakorum, on the Orkhon
            drives: (expansion: 4, military: 8, opportunism: 10, grudge: 4, risk: 8, patience: 2, builder: 2, wealth: 5, science: 3, defense: 1, seafaring: 0),
            army: (melee: 2, ranged: 7, cavalry: 10, siege: 4),
            agenda: (kind: StrongTake, name: "The Strong Take",
                description: "Attacks whichever neighbour has the weakest army, whatever their history. Backs off from anyone stronger and makes peace easily."),
            ability: (name: "Örtöö",
                description: "Units that start their turn inside Mongol borders get +1 movement.",
                effects: [MovesInTerritory(1)]),
            leader_ability: (name: "Submit or Perish",
                description: "Capturing a city yields 30 gold per citizen and fully heals the units next to it.",
                effects: [CaptureGold(30), CaptureHeal]),
            unique_units: ["keshig", "tumen"],
            unique_buildings: ["ordu"],
            cities: ["Karakorum", "Khanbaliq", "Shangdu", "Sarai", "Almaliq", "Beshbalik", "Avarga", "Khar Balgas", "Hami", "Turfan", "Khovd", "Uliastai", "Kherlen", "Ordu-Baliq", "Darkhan", "Olon Süme"],
            generals: ["Subutai", "Jebe", "Muqali", "Jochi", "Bayan", "Boorchu"],
            admirals: ["Hong Dagu", "Fan Wenhu", "Zhang Hongfan", "Ike Mese", "Shi Bi", "Liu Zheng"],
        ),
        (
            id: "mali",
            name: "Mali",
            adjective: "Malian",
            leader: "Mansa Musa",
            leader_title: "Lord of the Wangara Mines",
            colors: (primary: (46, 146, 74), secondary: (246, 200, 60)),
            emblem: "sun",
            description: "The richest kingdom of its age. Mansa Musa crossed the Sahara with so much gold that prices fell in Cairo for a decade, and filled Timbuktu with scholars.",
            start_bias: [Desert, River],
            home: Some((-8.4, 11.6)), // Niani, on the upper Niger
            drives: (expansion: 5, military: 2, opportunism: 2, grudge: 3, risk: 3, patience: 9, builder: 6, wealth: 10, science: 7, defense: 4, seafaring: 1),
            army: (melee: 4, ranged: 3, cavalry: 9, siege: 2),
            agenda: (kind: SleepingGiant, name: "Sleeping Giant",
                description: "Almost never declares war. Attack it, and it turns its treasury into an army overnight."),
            ability: (name: "Gold of the Sahel",
                description: "Desert tiles yield +1 gold.",
                effects: [TileYield(when: [Terrain("desert")], gold: 1)]),
            leader_ability: (name: "Hajj",
                description: "+15% gold in every city. Buying units and buildings costs 25% less.",
                effects: [GoldPercent(15), BuyDiscount(25)]),
            unique_units: ["mandekalu", "sofa"],
            unique_buildings: ["sankore"],
            cities: ["Niani", "Timbuktu", "Gao", "Djenné", "Kangaba", "Walata", "Tadmekka", "Koumbi Saleh", "Ségou", "Mopti", "Kirina", "Taghaza", "Kong", "Nioro", "Bamako", "Kayes"],
            generals: ["Sundiata", "Fakoli", "Tiramakhan", "Sakura", "Fran Kamara", "Kamandjan"],
            admirals: ["Abubakari", "Mari Djata", "Kassa", "Bakari", "Souleymane", "Moussa"],
        ),
        (
            id: "norse",
            name: "Norse",
            adjective: "Norse",
            leader: "Harald Hardrada",
            leader_title: "The Last Viking",
            colors: (primary: (44, 74, 158), secondary: (226, 222, 206)),
            emblem: "longship",
            description: "Sea raiders out of the fjords. Harald fought from Kyiv to Constantinople before taking the throne of Norway, and died trying to take England.",
            start_bias: [Taiga, Coast],
            home: Some((10.4, 63.4)), // Trondheim (Nidaros)
            drives: (expansion: 6, military: 7, opportunism: 8, grudge: 6, risk: 9, patience: 3, builder: 2, wealth: 6, science: 2, defense: 2, seafaring: 10),
            army: (melee: 9, ranged: 3, cavalry: 1, siege: 2),
            agenda: (kind: Plunder, name: "Plunder",
                description: "Raids rather than conquers: hunts units and loot, often leaves cities alone, and attacks even at bad odds."),
            ability: (name: "Raiders",
                description: "+25% strength when attacking from or onto a tile by the sea. Each enemy unit destroyed yields 10 gold.",
                effects: [Combat(percent: 25, when: Coastal), KillGold(10)]),
            leader_ability: (name: "The Last Viking",
                description: "Units heal as fast in enemy lands as in their own.",
                effects: [HealAnywhere]),
            unique_units: ["huscarl", "varangian"],
            unique_buildings: ["longhouse"],
            cities: ["Trondheim", "Kaupang", "Hedeby", "Birka", "Uppsala", "Roskilde", "Bergen", "Ribe", "Oslo", "Sigtuna", "Jelling", "Stavanger", "Lund", "Visby", "Tønsberg", "Kalmar"],
            generals: ["Ragnar", "Ivar the Boneless", "Rollo", "Cnut", "Olaf Tryggvason", "Sweyn Forkbeard"],
            admirals: ["Leif Erikson", "Erik the Red", "Harald Hardrada", "Thorfinn Karlsefni", "Bjarni Herjólfsson", "Haakon the Good"],
        ),
        (
            id: "korea",
            name: "Korea",
            adjective: "Korean",
            leader: "Sejong",
            leader_title: "The Great",
            colors: (primary: (236, 236, 240), secondary: (196, 40, 52)),
            emblem: "taegeuk",
            description: "A kingdom of scholars behind mountain walls. Sejong gave his people an alphabet anyone could learn in a morning, and rain gauges, sundials and rockets besides.",
            start_bias: [Hills, Coast],
            home: Some((127.0, 37.6)), // Seoul (Hanyang)
            drives: (expansion: 3, military: 4, opportunism: 1, grudge: 7, risk: 1, patience: 10, builder: 7, wealth: 4, science: 10, defense: 9, seafaring: 5),
            army: (melee: 4, ranged: 8, cavalry: 3, siege: 6),
            agenda: (kind: NeverForgive, name: "Never Forgive",
                description: "Never starts a war. Answers an attack with a full counter-invasion and keeps the attacker's cities."),
            ability: (name: "Hangul",
                description: "Libraries yield +2 science.",
                effects: [BuildingBonus(building: "library", science: 2)]),
            leader_ability: (name: "Scholar King",
                description: "Technologies another civilization already knows cost 25% less.",
                effects: [TechDiscount(25)]),
            unique_units: ["hwacha", "turtle_ship"],
            unique_buildings: ["hwaseong"],
            cities: ["Hanseong", "Gyeongju", "Gaeseong", "Pyeongyang", "Jeonju", "Busan", "Gwangju", "Daegu", "Suwon", "Chungju", "Hamhung", "Wonju", "Andong", "Jinju", "Naju", "Sangju"],
            generals: ["Gang Gam-chan", "Eulji Mundeok", "Gwon Yul", "Kim Yu-sin", "Gyebaek", "Gwak Jae-u"],
            admirals: ["Yi Sun-sin", "Won Gyun", "Yi Eok-gi", "Jeong Un", "Choe Mu-seon", "Jang Bogo"],
        ),
        (
            id: "aztecs",
            name: "Aztecs",
            adjective: "Aztec",
            leader: "Moctezuma I",
            leader_title: "He Who Shoots Arrows at the Sky",
            colors: (primary: (36, 176, 168), secondary: (180, 40, 40)),
            emblem: "sunstone",
            description: "An island city in a mountain lake that ruled an empire of tribute. Moctezuma the Elder built the causeways and aqueducts of Tenochtitlan and kept his rivals in endless Flower Wars.",
            start_bias: [Lake, Jungle, Marsh],
            home: Some((-99.1, 19.4)), // Tenochtitlan, on Lake Texcoco
            drives: (expansion: 6, military: 8, opportunism: 6, grudge: 5, risk: 7, patience: 3, builder: 5, wealth: 3, science: 2, defense: 3, seafaring: 1),
            army: (melee: 9, ranged: 4, cavalry: 0, siege: 2),
            agenda: (kind: FlowerWars, name: "Flower Wars",
                description: "Picks one rival early and keeps skirmishing with it for a long time, rarely bothering to take its cities."),
            ability: (name: "Tribute",
                description: "Each enemy unit destroyed adds 10 production to the nearest Aztec city.",
                effects: [KillProduction(10)]),
            leader_ability: (name: "Flower Wars",
                description: "+15% strength when attacking units.",
                effects: [Combat(percent: 15, when: AttackingUnits)]),
            unique_units: ["eagle_warrior", "jaguar_warrior"],
            unique_buildings: ["tlachtli"],
            cities: ["Tenochtitlan", "Texcoco", "Tlacopan", "Azcapotzalco", "Tlatelolco", "Xochimilco", "Coyoacan", "Chalco", "Culhuacan", "Iztapalapa", "Malinalco", "Teotihuacan", "Tula", "Cholula", "Toluca", "Chapultepec"],
            generals: ["Tlacaelel", "Ahuitzotl", "Cuauhtémoc", "Axayacatl", "Itzcoatl", "Tizoc"],
            admirals: ["Cuitláhuac", "Coanacoch", "Tetlepanquetzal", "Moquihuix", "Chimalpopoca", "Huitzilihuitl"],
        ),
        (
            id: "persia",
            name: "Persia",
            adjective: "Persian",
            leader: "Cyrus",
            leader_title: "King of the Four Corners",
            colors: (primary: (112, 58, 168), secondary: (226, 190, 90)),
            emblem: "winged_disc",
            description: "The first great empire of many peoples. Cyrus took Babylon by diverting its river, freed its captives and let every land keep its gods and customs.",
            start_bias: [Plains, Hills],
            home: Some((52.9, 29.9)), // Persepolis, in Pars
            drives: (expansion: 8, military: 6, opportunism: 6, grudge: 2, risk: 4, patience: 5, builder: 6, wealth: 7, science: 5, defense: 4, seafaring: 2),
            army: (melee: 6, ranged: 6, cavalry: 6, siege: 4),
            agenda: (kind: GraciousConqueror, name: "The Gracious Conqueror",
                description: "Goes after the biggest and richest city, not the weakest. Forgives quickly and accepts peace."),
            ability: (name: "Satrapies",
                description: "Captured cities keep all their citizens and stored production. Every city yields +1 gold.",
                effects: [KeepCapturedCities, GoldPerCity(1)]),
            leader_ability: (name: "Fall of Babylon",
                description: "+15% strength when attacking cities.",
                effects: [Combat(percent: 15, when: AttackingCities)],
                planned: Some("+2 movement on the first turn of a war.")),
            unique_units: ["immortal", "qizilbash"],
            unique_buildings: ["pairidaeza"],
            cities: ["Pasargadae", "Persepolis", "Susa", "Ecbatana", "Babylon", "Sardis", "Bactra", "Gordium", "Tarsus", "Arbela", "Rhagae", "Zarin", "Gabae", "Maracanda", "Pura", "Hecatompylos"],
            generals: ["Darius", "Mardonius", "Harpagus", "Datis", "Hydarnes", "Artaphernes"],
            admirals: ["Artemisia", "Ariabignes", "Achaemenes", "Megabates", "Prexaspes", "Damasithymus"],
